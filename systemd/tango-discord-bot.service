[Unit]
Description=Tango Discord Bot — command bot for Project Tango operations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/Project-Tango/backend/venv/bin/python /opt/Project-Tango/scripts/tango-discord-bot.py
WorkingDirectory=/opt/Project-Tango
User=root
Group=root
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=/opt/Project-Tango/.env

[Install]
WantedBy=multi-user.target