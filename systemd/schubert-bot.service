[Unit]
Description=Schubert Bot — Level 3 server-wide autonomous agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/Project-Tango/backend/venv/bin/python /opt/Project-Tango/scripts/schubert-bot.py
WorkingDirectory=/opt/Project-Tango
User=root
Group=root
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=/opt/Project-Tango/.env

[Install]
WantedBy=multi-user.target