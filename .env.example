# Project Tango Environment Variables
# ====================================
# Master environment file for Project Tango deployment on Schubert Nexus.
# Used by: tango-backend.service, tango-web.service, Discord bot fleet
#
# Location: /opt/Project-Tango/.env (this is the authoritative copy)
# Owner: z121532:z121532, mode 600 (sensitive credentials)

# ---------------------------------------------------------------------------
# LiveKit Configuration (Voice Agent Backend)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LIVEKIT_NUM_IDLE_PROCESSES=1

# ---------------------------------------------------------------------------
# TTS Configuration (F5-TTS + Fallback)
# ---------------------------------------------------------------------------
TANGO_F5_TTS_ENABLED=true
TANGO_F5_TTS_BASE_URL=http://127.0.0.1:8020
TANGO_F5_TTS_SAMPLE_RATE=24000
TANGO_F5_TTS_TIMEOUT_SECONDS=60
TANGO_F5_TTS_AUTO_START=true
TANGO_F5_TTS_START_TIMEOUT_SECONDS=600
TANGO_TTS_FALLBACK=true

# ---------------------------------------------------------------------------
# LLM Configuration (LiteLLM Proxy)
# ---------------------------------------------------------------------------
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://z121532@localhost/tango

# ---------------------------------------------------------------------------
# Web Backend Configuration
# ---------------------------------------------------------------------------
TANGO_CORS_ORIGINS=http://localhost:3006,http://127.0.0.1:3006
TANGO_AUTH_LOOKUP_KEY=
TANGO_PUBLIC_ORIGIN=https://project-tango.schubert.life
TANGO_AUTH_COOKIE_SECURE=true
TANGO_AUTH_SESSION_TTL_HOURS=168
TANGO_AUTH_IDLE_TTL_HOURS=12
TANGO_AUTH_PASSWORD_LENGTH=12
TANGO_SIP_OWNER_USER_ID=

# ---------------------------------------------------------------------------
# Vision Configuration (GPT-4o)
# ---------------------------------------------------------------------------
TANGO_VISION_ENABLED=true
TANGO_VISION_MODEL=openai/gpt-4o-mini
TANGO_VISION_OCR_MODEL=openai/gpt-4o
TANGO_VISION_INJECTION_MODE=auto
TANGO_VISION_FRAME_WIDTH=768
TANGO_VISION_FRAME_HEIGHT=768
TANGO_VISION_OCR_FRAME_WIDTH=1536
TANGO_VISION_OCR_FRAME_HEIGHT=1536
TANGO_VISION_MAX_TOKENS=120
TANGO_VISION_OCR_MAX_TOKENS=220
TANGO_VISION_TIMEOUT_SECONDS=8
TANGO_VISION_OCR_TIMEOUT_SECONDS=14
TANGO_VISION_IMAGE_DETAIL=auto
TANGO_VISION_OCR_IMAGE_DETAIL=high
TANGO_VISION_DEBUG_SUMMARIES=false

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
TANGO_ENABLE_LEGACY_TOOLS=false

# ---------------------------------------------------------------------------
# Discord Bot Fleet Configuration
# ---------------------------------------------------------------------------
# Admiral Schubert (Main AI assistant)
SCHUBERT_BOT_TOKEN=
SCHUBERT_BOT_ID=
SCHUBERT_CHANNEL_ID=

# The Architect (Development & deployment bot)
ARCHITECT_BOT_TOKEN=
ARCHITECT_CHANNEL_ID=

# Dr. Voss (Health monitoring bot)
DR_VOSS_BOT_TOKEN=
DR_VOSS_CHANNEL_ID=

# The Proctor (Testing & performance bot)
PROCTOR_BOT_TOKEN=
PROCTOR_CHANNEL_ID=
PROCTOR_ANALYSIS_CHANNEL_ID=

# Shared Discord Bot Configuration
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Slack Integration
# ---------------------------------------------------------------------------
# Slack App Credentials (Workspace Monitor app)
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_ID=
SLACK_SIGNING_SECRET=

# Slack Incoming Webhooks (Discord Bot Fleet → Slack cross-platform notifications)
# Create these at: https://api.slack.com/messaging/webhooks
# Format: https://hooks.slack.com/services/REPLACE_ME
SLACK_WEBHOOK_TANGO_OPS=
SLACK_WEBHOOK_TANGO_REPORTS=
SLACK_WEBHOOK_TANGO_DEV=

# ---------------------------------------------------------------------------
# n8n Alert Aggregation Hub
# ---------------------------------------------------------------------------
# Webhook URL for the n8n alert routing workflow
# Default: http://100.86.47.6:5678/webhook/tango-alert
N8N_ALERT_WEBHOOK_URL=http://100.86.47.6:5678/webhook/tango-alert
# HTTP timeout for alert dispatch (seconds)
N8N_ALERT_TIMEOUT=10
# Enable/disable alert dispatch (default: true)
N8N_ALERT_ENABLED=true

# ---------------------------------------------------------------------------
# MCP Servers Configuration
# ---------------------------------------------------------------------------
# Outline Wiki MCP Server (EL knowledge base)
MCP_OUTLINE_TOKEN=

# Slack MCP Server (Phase 2: Bidirectional Discord ↔ Slack integration)
MCP_SLACK_URL=http://127.0.0.1:8075/mcp
MCP_SLACK_ENABLED=true
MCP_SLACK_TIMEOUT=90

# ---------------------------------------------------------------------------
# WRITER Agent Playbook Integration
# ---------------------------------------------------------------------------
# API key for invoking WRITER playbooks via webhook
# Used by Discord bot fleet (The Architect) for auto-triggered playbooks
# Get this from: https://app.writer.com/settings/api-keys
WRITER_PLAYBOOK_API_KEY=

# ---------------------------------------------------------------------------
# MeetScribe Integration (Meeting Corpus → Discord Bot Context)
# ---------------------------------------------------------------------------
# API key for MeetScribe REST API (Bearer token with ms_live_ prefix)
# Get this from: MeetScribe Settings → API Keys
MEETSCRIBE_API_KEY=
# HMAC-SHA256 secret for verifying MeetScribe webhook payloads
# Generate with: openssl rand -hex 32
MEETSCRIBE_WEBHOOK_SECRET=
# MeetScribe API base URL
MEETSCRIBE_API_URL=https://meetscribe.jgeronimo.com/api
# Enable/disable MeetScribe integration (default: true)
MEETSCRIBE_ENABLED=true
# Local cache file for session metadata (webhook-driven cache)
MEETSCRIBE_CACHE_PATH=/opt/Project-Tango/data/meetscribe_cache.json
