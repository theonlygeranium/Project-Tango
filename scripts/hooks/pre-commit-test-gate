#!/usr/bin/env bash
# Pre-commit test gate — runs Sentinel enforcement check on staged files.
# Ensures bot code changes include corresponding test recipe updates.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PYTHON="${REPO_ROOT}/venv/bin/python"

if [ ! -f "${PYTHON}" ]; then
    PYTHON="python3"
fi

cd "${REPO_ROOT}"

PYTHONPATH="${REPO_ROOT}/src:${PYTHONPATH:-}" "${PYTHON}" -m nexus.testing.enforcement --check-commit
