            "persistent memory, and interactive UI. Type naturally or use commands below."
        ),
        color=COLOR_PHASE4,
        timestamp=datetime.now(timezone.utc),
    )

    embed.add_field(
        name="🚀 Interactive",
        value=(
            "`!setup` — Open the interactive setup wizard (buttons & forms)\n"
            "`!help` — Show this help"
        ),
        inline=False,
    )
    embed.add_field(
        name="📊 Server Commands",
        value=(
            "`!status` — Server health snapshot\n"
            "`!services` — All service statuses\n"
            "`!logs <service>` — Recent logs\n"
            "`!restart <service>` — Restart a service\n"
            "`!disk` — Disk usage\n"
            "`!mem` — Memory & swap\n"
            "`!procs` — Top processes\n"
            "`!net` — Network ports"
        ),
        inline=False,
    )
    embed.add_field(
        name="🔊 Voice",
        value=(
            "`!join` — Join your voice channel\n"
            "`!leave` — Leave voice channel"
        ),
        inline=False,
    )
    embed.add_field(
        name="🧠 Memory & Projects",
        value=(
            "`!memory` — Memory queries (search/stats/entity/recent)\n"
            "`!project` — Project management (create/bind/list/info/set/delete)\n"
            "`!session` — Session management\n"
            "`!mcp` — MCP server status"
        ),
        inline=False,
    )
    embed.add_field(
        name="💬 Natural Language",
        value=(
            "Just type naturally! I understand requests like:\n"
            "• \"Create a channel for my GitHub repo\"\n"
            "• \"What can you tell me about the vinifera project?\"\n"
            "• \"Check the latest PRs on vinifera\"\n"
